#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    double3 xformOp:translate = (0, 10, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Camera "Shot"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        float horizontalApertureOffset = 1.5
        float2 clippingRange = (0.5, 5000)
        float focusDistance = 250
        float fStop = 2.8
        double shutter:open = -0.25
        double shutter:close = 0.25
        double3 xformOp:translate = (0, 0, 500)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Plan"
    {
        token projection = "orthographic"
    }

    def RectLight "Key"
    {
        float inputs:intensity = 20
        float inputs:exposure = 1.5
        color3f inputs:color = (1, 0.5, 0.25)
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 3200
        bool inputs:normalize = 1
        float inputs:width = 2
        float inputs:height = 3
    }

    def DiskLight "Old"
    {
        float intensity = 7
        float radius = 4
    }

    def SphereLight "Bulb"
    {
        float inputs:radius = 0.1
    }

    def DistantLight "Sun"
    {
        float inputs:angle = 1
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.5
        asset inputs:texture:file = @sky/noon.exr@
    }

    def SphereLight "Spot" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:radius = 0.25
        float inputs:shaping:cone:angle = 30
        float inputs:shaping:cone:softness = 0.5
    }

    def CylinderLight "Tube"
    {
        float inputs:length = 2
    }
}
