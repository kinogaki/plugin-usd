#usda 1.0
(
    defaultPrim = "Shot"
    upAxis = "Z"
    metersPerUnit = 1
)

class "_Base"
{
    custom string inherited = "inherit"
    custom string winner = "inherit"
}

class "_Special"
{
    custom string winner = "specialize"
    custom string specialized = "specialize"
}

def Xform "Shot" (
    inherits = </_Base>
    specializes = </_Special>
    references = @./livrps_ref.usda@</Model>
    payload = @./livrps_payload.usda@</Heavy>
    variantSets = "look"
    variants = {
        string look = "red"
    }
)
{
    custom string local = "local"

    variantSet "look" = {
        "blue" {
            custom string color = "blue"
            custom string winner = "variant"
        }
        "red" {
            custom string color = "red"
        }
    }
}
